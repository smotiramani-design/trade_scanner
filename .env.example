# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored — safe for secrets.

# ── Required to run anything (config.py requires this at import) ───────────────
FMP_API_KEY=your_fmp_api_key_here

# ── Required for the ML tuner + dashboard data (Supabase Postgres URI) ─────────
# Supabase → Project Settings → Database → Connection string → URI
# postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Auto-on when DATABASE_URL is set; leave as-is.
DB_ENABLED=true
# Log the full scanned universe (de-biased training set). Keep true.
LOG_UNIVERSE=true
