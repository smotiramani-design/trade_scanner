# Copy to .env.local and fill in. Get these from Supabase:
#   Project Settings → API → Project URL and anon/public key.
# The anon key is safe to expose to the browser (read-only via RLS/grants).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Base URL of the Python scanner engine used by the "Analyze Ticker" page.
# Local dev:  uvicorn web.api:app --port 8000
# Production: the AWS Lambda Function URL (https://<id>.lambda-url.<region>.on.aws)
# Server-side only (not exposed to the browser). Defaults to localhost:8000.
SCANNER_API_URL=http://localhost:8000

# Shared secret for the public Lambda Function URL. Must match ANALYZE_API_TOKEN
# set on the Lambda. Sent as the x-api-token header from the server-side proxy,
# so it never reaches the browser. Leave blank for local dev (no auth).
ANALYZE_API_TOKEN=
